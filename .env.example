SENIOR_WSDL_DOCUMENTO_FISCAL=http://<senior-host>:<porta>/g5-senior-services/sapiens_Synccom_senior_g5_co_int_venda_documentofiscal?wsdl
SENIOR_WS_DRY_RUN=True
SENIOR_WS_PASSWORD=<change-me>

# Postgres (Separa local DB)
POSTGRES_DB=<change-me>
POSTGRES_USER=<change-me>
