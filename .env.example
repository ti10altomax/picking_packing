# Senior Web Services
SENIOR_WSDL_EMBALAGEM=http://<senior-host>:<porta>/g5-senior-services/sapiens_Synccom_senior_g5_co_mcm_ven_embalagempfa?wsdl
SENIOR_WS_USER=<change-me>
# Carta de correção (ponto 6): mesmo host; SENIOR_WS_DRY_RUN=True não chama o Senior
