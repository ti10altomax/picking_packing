{
  "expo": {
    "name": "Separa",
    "slug": "separa",
    "scheme": "separa",
    "version": "0.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#09090b",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.altomax.separa"
    },
    "android": {
      "package": "br.com.altomax.separa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#09090b"
      },
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permitir que o Separa salve sua sessão com segurança."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o Separa use a câmera para ler códigos de barras.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "780587d0-ba31-40ed-ab02-5a2c4ef3e7cb"
      }
    },
    "owner": "silvio.altomax",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/780587d0-ba31-40ed-ab02-5a2c4ef3e7cb"
    }
  }
}
