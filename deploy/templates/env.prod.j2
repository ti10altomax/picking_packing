# Renderizado pelo Ansible — não editar manualmente na VM
# (mexer em deploy/group_vars/separa_prod/vars.yml e rodar deploy de novo).

# Django
DJANGO_SECRET_KEY={{ django_secret_key }}
DJANGO_DEBUG={{ django_debug }}
DJANGO_ALLOWED_HOSTS={{ django_allowed_hosts }}
CORS_ALLOWED_ORIGINS={{ cors_allowed_origins }}

# Postgres
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_HOST={{ postgres_host }}
POSTGRES_PORT={{ postgres_port }}

# Redis / Celery
REDIS_URL={{ redis_url }}

# Oracle Senior (read-only)
ORACLE_DB={{ oracle_db }}
ORACLE_USER={{ oracle_user }}
ORACLE_PASSWORD={{ oracle_password }}
ORACLE_HOST={{ oracle_host }}
ORACLE_PORT={{ oracle_port }}
ORACLE_SCHEMA={{ oracle_schema }}

# Senior SOAP
SENIOR_WSDL_EMBALAGEM={{ senior_wsdl_embalagem }}
SENIOR_WS_USER={{ senior_ws_user }}
SENIOR_WS_PASSWORD={{ senior_ws_password }}

# VTEX (congelado, mas as vars precisam existir)
VTEX_ACCOUNT_NAME={{ vtex_account_name }}
VTEX_APP_KEY={{ vtex_app_key }}
VTEX_APP_TOKEN={{ vtex_app_token }}

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES={{ jwt_access_token_lifetime_minutes }}
JWT_REFRESH_TOKEN_LIFETIME_DAYS={{ jwt_refresh_token_lifetime_days }}
