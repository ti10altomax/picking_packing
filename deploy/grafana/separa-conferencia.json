            "steps": [
              {
                "color": "#78716c",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Não conformes abertos agora",
      "description": "Pedidos que estão em Não conforme neste momento, aguardando ação do Sup. Pátio",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 21,
        "y": 8,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS abertos FROM pedidos_pedido WHERE status = 'nao_conforme'"
