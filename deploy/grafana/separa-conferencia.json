{
  "__inputs": [
    {
      "name": "DS_SEPARA",
      "label": "Postgres do Separa",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [],
  "title": "Separa — Conferência",
  "uid": "separa-conferencia",
  "tags": [
    "separa"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Pedidos no fluxo, por status",
      "description": "Sem os Pendentes (só o que já foi selecionado pra separação)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT status AS metric, count(*) AS value\nFROM pedidos_pedido\nWHERE status IN ('selecionado','atribuido','conferindo','aguardando_fechamento','conferido','nao_conforme')\nGROUP BY status"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "minVizHeight": 16,
        "minVizWidth": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pendente"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#78716c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "selecionado"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "atribuido"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "conferindo"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "aguardando_fechamento"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "conferido"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "nao_conforme"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "metric",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "value",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Fila por conferente",
      "description": "Pedidos atribuídos ou em conferência, por conferente",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT u.username AS metric, count(*) AS value\nFROM pedidos_pedido p\nJOIN core_user u ON u.id = p.conferente_id\nWHERE p.status IN ('atribuido','conferindo')\nGROUP BY u.username\nORDER BY value DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "minVizHeight": 16,
        "minVizWidth": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "metric",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "value",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Atribuído mais antigo sem iniciar",
      "description": "Horas desde a atribuição do pedido mais antigo que ainda está em Atribuído",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(extract(epoch FROM now() - min(atribuido_em)) / 3600, 0) AS horas\nFROM pedidos_pedido\nWHERE status = 'atribuido'"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              },
              {
                "color": "red",
                "value": 24
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Falhas no WS Senior",
      "description": "Conferidos que o Senior ainda não confirmou após pelo menos uma tentativa",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS falhas\nFROM pedidos_pedido\nWHERE status = 'conferido' AND senior_atualizado_em IS NULL AND senior_tentativas > 0"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Não conformes registrados, por motivo",
      "description": "Todas as marcações de Não conforme no período (histórico do PedidoLog), mesmo as já retornadas à fila",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 14,
        "y": 8,
        "w": 7,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT payload->>'motivo' AS metric, count(*) AS value\nFROM pedidos_pedidolog\nWHERE acao = 'pedido_nao_conforme' AND $__timeFilter(criado_em)\nGROUP BY 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "divergencia_qtd"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Divergência de quantidade"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "produto_errado"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Produto errado"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "item_ausente"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Item ausente"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "metric",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "value",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Conferidos por dia",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', conferido_em) AS time, count(*) AS conferidos\nFROM pedidos_pedido\nWHERE conferido_em IS NOT NULL AND $__timeFilter(conferido_em)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tempo de conferência — mediana (min)",
      "description": "Mediana do início ao conferido; não é distorcida por pedidos esquecidos abertos",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', conferido_em) AS time,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM conferido_em - conferencia_iniciada_em)) / 60 AS minutos\nFROM pedidos_pedido\nWHERE conferido_em IS NOT NULL AND conferencia_iniciada_em IS NOT NULL\n  AND $__timeFilter(conferido_em)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Erros de separação por separador",
      "description": "Sobra (a mais) e falta (a menos) registradas no período",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.nome AS separador,\n       count(*) FILTER (WHERE e.tipo = 'a_menos') AS faltas,\n       count(*) FILTER (WHERE e.tipo = 'a_mais')  AS sobras,\n       sum(e.qtd) AS pecas\nFROM pedidos_erroseparacao e\nJOIN pedidos_separador s ON s.id = e.separador_id\nWHERE $__timeFilter(e.criado_em)\nGROUP BY s.nome ORDER BY faltas DESC"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Divergências de barra por dia",
      "description": "Código bipado diferente do EAN cadastrado — liberado pelo supervisor",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', criado_em) AS time, count(*) AS divergencias\nFROM pedidos_divergenciabarra\nWHERE $__timeFilter(criado_em)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Em conferência há mais de 2 h",
      "description": "Possível pedido esquecido aberto no coletor",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT p.numero_externo AS pedido, p.cliente, u.username AS conferente,\n       round(extract(epoch FROM now() - p.conferencia_iniciada_em) / 3600, 1) AS horas\nFROM pedidos_pedido p\nLEFT JOIN core_user u ON u.id = p.conferente_id\nWHERE p.status = 'conferindo'\n  AND p.conferencia_iniciada_em < now() - interval '2 hours'\nORDER BY horas DESC"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Pendentes (vindos do Senior)",
      "description": "Pedidos e NFs sincronizados que ainda não foram selecionados",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 10,
        "y": 8,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS pendentes FROM pedidos_pedido WHERE status = 'pendente'"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#78716c"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#78716c",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Não conformes abertos agora",
      "description": "Pedidos que estão em Não conforme neste momento, aguardando ação do Sup. Pátio",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 21,
        "y": 8,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS abertos FROM pedidos_pedido WHERE status = 'nao_conforme'"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}