      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Último sync Senior (há)",
      "description": "Minutos desde a última execução OK de sincronizar_pedidos_oracle (core_execucaotarefa). Beat = 2 min; vermelho acima de 6.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() - max(iniciada_em)))/60 AS minutos\nFROM core_execucaotarefa\nWHERE tarefa = 'apps.senior.tasks.sincronizar_pedidos_oracle' AND status = 'ok'"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              },
              {
                "color": "red",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Último monitor de cancelamentos (há)",
      "description": "Minutos desde a última execução OK de monitorar_cancelamentos. Beat = 1 min; vermelho acima de 3.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 6,
        "y": 37,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() - max(iniciada_em)))/60 AS minutos\nFROM core_execucaotarefa\nWHERE tarefa = 'apps.senior.tasks.monitorar_cancelamentos' AND status = 'ok'"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Tarefas com erro (24 h)",
      "description": "Execuções com status erro nas últimas 24 h (inclui Oracle fora durante o sync).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS erros FROM core_execucaotarefa\nWHERE status = 'erro' AND iniciada_em > now() - interval '24 hours'"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Duração do sync Senior (s)",
      "description": "Tempo de cada execução de sincronizar_pedidos_oracle. Subindo = Oracle lento ou janela grande.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 16,
        "y": 37,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT iniciada_em AS time, duracao_ms/1000.0 AS segundos\nFROM core_execucaotarefa\nWHERE tarefa = 'apps.senior.tasks.sincronizar_pedidos_oracle' AND duracao_ms IS NOT NULL AND $__timeFilter(iniciada_em)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Cancelados pelo Senior, por dia",
      "description": "Documentos que o beat monitorar_cancelamentos marcou Cancelado (cancelado_origem = senior).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', cancelado_em) AS time, count(*) AS cancelados\nFROM pedidos_pedido\nWHERE cancelado_origem = 'senior' AND $__timeFilter(cancelado_em)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Atribuição: Pátio × conferente bipando",
      "description": "pedido_atribuido por dia — via = 'bipagem' é o conferente pegando a nota (ponto 4); o resto é o Sup. Pátio atribuindo.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
        "x": 8,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SEPARA}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', criado_em) AS time,\n  CASE WHEN payload->>'via' = 'bipagem' THEN 'conferente bipou' ELSE 'patio atribuiu' END AS metric,\n  count(*) AS qtd\nFROM pedidos_pedidolog\nWHERE acao = 'pedido_atribuido' AND $__timeFilter(criado_em)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Etiquetas de volume, por dia",
      "description": "ImpressaoEtiqueta por status (ok / erro). Pendentes vivem em Gestão → Etiquetas.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SEPARA}"
      },
      "gridPos": {
